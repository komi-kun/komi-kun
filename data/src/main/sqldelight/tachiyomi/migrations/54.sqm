-- SyncYomi reconciles manga by `version` (SyncService/merge and RestoreRepositoryImpl) and
-- `SyncManager.isMangaDifferent` does not compare the cover URL. A cover-only change used to
-- leave `version` (and therefore the winner of a merge tie) unchanged, so the new URL was
-- uploaded but silently discarded on other devices. Include `remote_cover` in the version bump.
--
-- `state_cover_last_modified` is intentionally not involved: it is a local Coil cache key
-- component and is not part of BackupManga.
DROP TRIGGER IF EXISTS update_manga_version;

CREATE TRIGGER update_manga_version AFTER UPDATE ON manga
BEGIN
    UPDATE manga SET version = version + 1
    WHERE id = new.id AND new.is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.remote_cover IS NOT old.remote_cover OR
        new.user_favorite_at IS NOT old.user_favorite_at
    );
END;
