// Renovate config for komi-kun.
//
// Based on upstream Mihon's `.github/renovate.json5` (recommended defaults, a
// `Dependencies` label, and one grouped PR for pinned GitHub Actions digests),
// kept in-repo instead of extending Mihon's file by remote preset so an upstream
// edit cannot silently change this fork's dependency policy. One deliberate
// difference: semantic-commit prefixes are enabled so dependency updates use
// `chore(deps):`, matching the rest of this repo's commit history.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["Dependencies"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
    },
  ],
}
