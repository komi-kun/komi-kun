    <!-- KUN: Yomitan Dexie-backup import (on-device) -->
    <string name="pref_import_yomitan_backup">Yomitan காப்புப்பிரதியை இறக்குமதி செய் (.json)</string>
    <string name="pref_import_yomitan_backup_summ">Yomitan Dexie காப்புப்பிரதியிலிருந்து ஒவ்வொரு அகராதியையும் இறக்குமதி செய்</string>
    <string name="yomitan_backup_intro">ஒரு Yomitan Dexie காப்புப்பிரதியைத் தேர்ந்தெடுக்கவும் (yomitan-dictionaries-*.json). அதில் உள்ள ஒவ்வொரு அகராதியும் சாதனத்திலேயே மீண்டும் உருவாக்கப்பட்டு இறக்குமதி செய்யப்படுகிறது. இதற்கு பல நிமிடங்கள் ஆகலாம் மற்றும் அதிக தற்காலிக சேமிப்பிடம் தேவைப்படும் — பயன்பாட்டைத் திறந்து வைத்திருங்கள் மற்றும் சாதனத்தை சார்ஜ் செய்யுங்கள்.</string>
    <string name="yomitan_backup_choose_file">காப்புப்பிரதி கோப்பைத் தேர்ந்தெடு</string>
    <string name="yomitan_backup_import">இறக்குமதி செய்</string>
    <string name="yomitan_backup_cancel">இறக்குமதியை ரத்துசெய்</string>
    <string name="yomitan_backup_keep_importing">இறக்குமதியைத் தொடர்</string>
    <string name="yomitan_backup_cancel_confirm_title">இறக்குமதியை ரத்துசெய்யவா?</string>
    <string name="yomitan_backup_cancel_confirm_message">ஏற்கனவே இறக்குமதி செய்யப்பட்ட அகராதிகள் வைக்கப்படும். அதே காப்புப்பிரதியை மீண்டும் இயக்குவது தொடரப்பட்டு அவற்றை தவிர்க்கும்.</string>
