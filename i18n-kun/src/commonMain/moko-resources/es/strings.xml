    <string name="pref_ocr_detection">Ajuste de detección</string>
    <string name="pref_ocr_advanced_tuning">Ajuste avanzado</string>
    <string name="pref_ocr_advanced_tuning_summary">Muestra los controles del detector y del reconocimiento. Mientras está desactivado, el OCR usa siempre los valores predeterminados; tus propios valores se conservan y vuelven al activarlo de nuevo.</string>
    <string name="pref_ocr_det_pixel_threshold">Umbral de detección</string>
    <string name="pref_ocr_det_pixel_threshold_summary">Qué tan tenue puede ser una región de texto para seguir siendo detectada. Valores más bajos detectan texto más tenue pero también más ruido; aumenta este valor para evitar que áreas vacías se detecten como texto.</string>
    <string name="pref_ocr_det_box_threshold">Umbral de puntuación de cuadros de detección</string>
    <string name="pref_ocr_det_box_threshold_summary">Confianza mínima para conservar una región detectada. Auméntala para descartar cuadros débiles o falsos; redúcela para recuperar texto tenue. Es el control principal para evitar cuadros en áreas vacías.</string>
    <string name="pref_ocr_det_unclip_ratio">Expansión de cuadros de texto</string>
    <string name="pref_ocr_det_unclip_ratio_summary">Cuánto se expande cada cuadro detectado antes del reconocimiento (100-300, es decir, 1.00-3.00). Valores más altos incluyen más trazos circundantes; valores más bajos ajustan cuadros que abarcan ilustraciones.</string>
    <string name="pref_ocr_rec_confidence_floor">Límite inferior de confianza de reconocimiento</string>
    <string name="pref_ocr_rec_confidence_floor_summary">Descarta las líneas reconocidas cuya confianza sea inferior a esta. 0 conserva todo; auméntalo para eliminar líneas distorsionadas o mal leídas a costa de perder las tenues.</string>
    <string name="pref_ocr_det_resolution">Resolución del detector</string>
    <string name="pref_ocr_det_resolution_summary">Un valor más alto lee mejor el texto pequeño y denso, pero es más lento y puede añadir ruido. El valor predeterminado es 960.</string>
    <string name="pref_ocr_det_resolution_default">Predeterminada (960)</string>
    <string name="pref_ocr_det_resolution_high">Alta (1280)</string>
    <string name="pref_ocr_det_resolution_very_high">Muy alta (1600)</string>
    <string name="pref_ocr_det_resolution_auto">Automática (según el tamaño de la página)</string>
